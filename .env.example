# ==============================================================
# Velurian Frontend Environment Variables (.env.local template)
# ==============================================================

# Standalone Backend Service (Express REST API on Port 5000)
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dashboard?schema=public"

# JWT Authentication Secret Key (must match backend JWT_SECRET)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
ADMIN_EMAIL="admin@velurian.atelier"
ADMIN_PASSWORD="your_admin_password_here"

# Public API Key for external storefront feeds (/api/products/all)
MY_SECRET_KEY="your-storefront-api-key-here"

# NextAuth & OAuth (Optional / Legacy session compatibility)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-nextauth-secret-key-change-in-production"
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"
